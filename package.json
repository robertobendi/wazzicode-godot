{
  "name": "godot-vibe-os",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Godot Vibe OS — a live Godot editor operating layer for AI-assisted game development.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:godot": "node tests/godot/integration.mjs",
    "gvibe": "node apps/cli/bin/gvibe"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
